# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# storybook
/storybook-static

# testing
/coverage
/playwright-report
/playwright/.cache
/test-results
# Note: Visual regression snapshots are committed to track baseline images

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Godot game exports (large binary files)
public/games/*
!public/games/README.md
!public/games/mock-game/

# Auto Claude data directory
.auto-claude/

# Auto Claude generated files
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/

# Spec-Kit (commit specs, ignore scratch files)
.specify/scratch/
.specify/**/*.tmp
.specify/**/.DS_Store


# Spec Kit temporary files
.speckit/tmp/
.speckit/cache/
.speckit/*.tmp
*.speckit-tmp
/.idea/

# Supabase local CLI state
supabase/.temp/
nul

# Superpowers
.superpowers/
docs/superpowers/
.claude/settings.local.json

context.md
subagent/*


tmp/*