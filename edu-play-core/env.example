# Local Supabase CLI note:
# `npm run dev:full` auto-generates `.env.local` with the correct local API URL,
# anon key, and service role key. You usually do NOT need to copy this file
# for local development.
#
# Use this file only when you want to point the app at a different Supabase
# project or provide manual overrides.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Feature Flags (env-var-backed; see ARCHITECTURE.md § Feature Flags)
# Accepted truthy values: "1", "true", "on" (case-insensitive). Anything else
# (including unset) means OFF. Defaults to OFF in production.
#
# listen_tap_audio — gates the listen-and-tap audio game in student catalogs.
# Stays OFF in production until EDU-62 (voice talent) lands and recorded audio
# replaces TTS placeholders. Teacher authoring UI is NOT gated by this flag.
NEXT_PUBLIC_FEATURE_LISTEN_TAP_AUDIO=0

# Directus CMS (self-hosted, see docker-compose.yml `directus` service)
#
# Phase 1: Directus runs locally on http://localhost:8055 and connects to the
# Supabase Postgres as the `directus_admin` role. Bootstrap once with:
#
#   docker compose exec supabase-db psql -U postgres -d postgres \
#     -c "ALTER ROLE directus_admin WITH LOGIN PASSWORD '<value of DIRECTUS_DB_PASSWORD>';"
#
# KEY and SECRET should be 32-char random strings in any non-local environment.
DIRECTUS_KEY=replace-me-32-char-random-string-aaaa
DIRECTUS_SECRET=replace-me-32-char-random-string-bbbb
DIRECTUS_DB_PASSWORD=directus-local-dev
DIRECTUS_ADMIN_EMAIL=admin@eduplay.local
DIRECTUS_ADMIN_PASSWORD=changeme
