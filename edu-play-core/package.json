{
  "name": "edu-play-core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:full": "node scripts/dev.mjs",
    "dev:docker": "node scripts/dev.mjs --docker",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:status": "node scripts/dev.mjs status",
    "build": "npm run build:activity-protocol && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build:activity-protocol": "npm run build --workspace=@edu-play/activity-protocol",
    "verify:agent": "npm run lint && npm run typecheck && npm run test:unit && tsx scripts/check-agent-guardrails.ts --types-drift-if-needed",
    "check:agent-guardrails": "tsx scripts/check-agent-guardrails.ts",
    "audit:mantine": "node scripts/audit-mantine.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:scripts": "bash scripts/post-paperclip-summary.test.sh",
    "test:unit": "vitest run",
    "test:db:concurrency": "node scripts/test-learning-path-concurrency.mjs",
    "test:db:native-concurrency": "node scripts/test-native-submission-concurrency.mjs",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "playwright test tests/e2e/specs/auth/teacher-login.spec.ts tests/e2e/specs/auth/student-login.spec.ts tests/e2e/specs/parent/notifications.spec.ts tests/e2e/specs/admin/overview.spec.ts tests/e2e/specs/assignments/create-assign-launch.spec.ts --project=chromium",
    "test:e2e:chromium": "playwright test --project=chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:types": "npx supabase gen types typescript --local > src/shared/types/database.ts",
    "check:types-drift": "bash scripts/check-supabase-types-drift.sh",
    "seed": "tsx scripts/seed/index.ts",
    "seed:minimal": "tsx scripts/seed/index.ts --tier minimal",
    "seed:medium": "tsx scripts/seed/index.ts --tier medium",
    "seed:full": "tsx scripts/seed/index.ts --tier full",
    "seed:clean": "tsx scripts/seed/index.ts --clean",
    "db:reset": "supabase db reset --local && npm run seed",
    "dev:turbo": "next dev --turbopack"
  },
  "dependencies": {
    "@edu-play/activity-protocol": "*",
    "@hookform/resolvers": "5.2.2",
    "@mantine/core": "9.2.2",
    "@mantine/form": "9.2.2",
    "@mantine/hooks": "9.2.2",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.105.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bcryptjs": "3.0.3",
    "framer-motion": "12.38.0",
    "i18next": "26.0.8",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.0",
    "react-i18next": "16.6.6",
    "recharts": "3.8.1",
    "zod": "4.3.6",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/nextjs-vite": "10.4.1",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/zxcvbn": "4.4.5",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-storybook": "10.4.1",
    "jsdom": "27.4.0",
    "playwright": "1.59.1",
    "postcss": "8.5.15",
    "storybook": "10.4.1",
    "supabase": "2.98.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "vite": "8.0.2"
  }
}
