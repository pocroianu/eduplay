{
  "$ref": "#/definitions/activity-assets",
  "definitions": {
    "activity-assets": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "baseUrl": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "assets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "path",
              "assets"
            ],
            "additionalProperties": false
          }
        },
        "shared": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "assets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "path",
              "assets"
            ],
            "additionalProperties": false
          }
        },
        "sharedGroups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "images": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "audio": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "spritesheets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "atlasUrl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "frames": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "key",
                    "url",
                    "atlasUrl"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "images",
              "audio"
            ],
            "additionalProperties": false
          }
        },
        "pinnedAssets": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "assetId": {
                    "type": "string",
                    "pattern": "^sha256-[a-f0-9]{64}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/assets\\/library\\/images\\/[A-Za-z0-9][A-Za-z0-9._-]*\\.png$"
                  }
                },
                "required": [
                  "type",
                  "assetId",
                  "sha256",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "audio"
                  },
                  "assetId": {
                    "type": "string",
                    "pattern": "^sha256-[a-f0-9]{64}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/assets\\/library\\/audio\\/[A-Za-z0-9][A-Za-z0-9._-]*\\.(mp3|wav)$"
                  }
                },
                "required": [
                  "type",
                  "assetId",
                  "sha256",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "games": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "manifest": {
                "type": "object",
                "properties": {
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "audio": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "spritesheets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "atlasUrl": {
                          "type": "string",
                          "minLength": 1
                        },
                        "frames": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "key",
                        "url",
                        "atlasUrl"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "images",
                  "audio"
                ],
                "additionalProperties": false
              },
              "sharedGroups": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "variations": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "manifest": {
                      "type": "object",
                      "properties": {
                        "images": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "audio": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "spritesheets": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "key": {
                                "type": "string",
                                "minLength": 1
                              },
                              "url": {
                                "type": "string",
                                "minLength": 1
                              },
                              "atlasUrl": {
                                "type": "string",
                                "minLength": 1
                              },
                              "frames": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            },
                            "required": [
                              "key",
                              "url",
                              "atlasUrl"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "sharedGroups": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "manifest"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "baseUrl",
        "games"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Activity-version asset manifest"
}