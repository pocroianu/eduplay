{
  "$ref": "#/definitions/game-config.listen-tap",
  "definitions": {
    "game-config.listen-tap": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "gameId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "totalSteps": {
              "type": "integer",
              "minimum": 0
            },
            "themeName": {
              "type": "string"
            },
            "theme": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "secondary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "background": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "cardBg": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "textColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$|^#[0-9A-Fa-f]{3}$|^rgb\\(|^rgba\\("
                },
                "containerBg": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "containerText": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$|^#[0-9A-Fa-f]{3}$|^rgb\\(|^rgba\\("
                },
                "containerBorder": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "backgroundStyle": {
                  "type": "string"
                },
                "correctColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "incorrectColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "starColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                }
              },
              "additionalProperties": false
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "supportedLanguages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "en",
                  "ro"
                ]
              },
              "minItems": 1
            },
            "gameType": {
              "type": "string",
              "const": "listen-tap"
            },
            "pointsPerRound": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "roundDelay": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "gameId",
            "version",
            "supportedLanguages",
            "gameType"
          ],
          "additionalProperties": false
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "promptAudioId": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "imageAssetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "correct": {
                      "type": "boolean"
                    },
                    "letter": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "imageAssetId",
                    "correct"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 6
              }
            },
            "required": [
              "id",
              "promptAudioId",
              "choices"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "questionKey": {
                "type": "string",
                "minLength": 1
              },
              "audioKey": {
                "type": "string"
              },
              "imageKey": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image",
                        "audio"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "isCorrect": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "value",
                    "isCorrect"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 6
              },
              "timeLimit": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "questionKey",
              "choices"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "meta",
        "rounds"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Listen-tap game configuration"
}