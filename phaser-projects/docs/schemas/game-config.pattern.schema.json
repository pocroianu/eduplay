{
  "$ref": "#/definitions/game-config.pattern",
  "definitions": {
    "game-config.pattern": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "gameId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "totalSteps": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "themeName": {
              "type": "string"
            },
            "theme": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "secondary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "background": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "cardBg": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "textColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$|^#[0-9A-Fa-f]{3}$|^rgb\\(|^rgba\\("
                },
                "containerBg": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "containerText": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$|^#[0-9A-Fa-f]{3}$|^rgb\\(|^rgba\\("
                },
                "containerBorder": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "backgroundStyle": {
                  "type": "string"
                },
                "correctColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "incorrectColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "starColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                }
              },
              "additionalProperties": false
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "supportedLanguages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "en",
                  "ro"
                ]
              },
              "minItems": 1
            },
            "gameType": {
              "type": "string",
              "const": "pattern"
            },
            "pointsPerRound": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "roundDelay": {
              "type": "number",
              "minimum": 0
            },
            "defaultSize": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "gameId",
            "version",
            "totalSteps",
            "supportedLanguages",
            "gameType"
          ],
          "additionalProperties": false
        },
        "tiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string",
                "minLength": 1
              },
              "fillColor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777215
              },
              "size": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "shape",
              "fillColor"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "minLength": 1
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "gapCount": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "distractors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "pattern",
              "gapCount"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "questionKey": {
                "type": "string",
                "minLength": 1
              },
              "audioKey": {
                "type": "string"
              },
              "imageKey": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image",
                        "audio"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "isCorrect": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "value",
                    "isCorrect"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 6
              },
              "timeLimit": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "questionKey",
              "choices"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "meta",
        "tiles",
        "rounds"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Pattern game configuration"
}