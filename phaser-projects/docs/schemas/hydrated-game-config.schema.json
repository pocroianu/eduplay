{
  "$ref": "#/definitions/hydrated-game-config",
  "definitions": {
    "hydrated-game-config": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "gameId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "totalSteps": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "theme": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "secondary": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "background": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "cardBg": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "textColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$|^#[0-9A-Fa-f]{3}$|^rgb\\(|^rgba\\("
                },
                "containerBg": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "containerText": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$|^#[0-9A-Fa-f]{3}$|^rgb\\(|^rgba\\("
                },
                "containerBorder": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "backgroundStyle": {
                  "type": "string"
                },
                "correctColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "incorrectColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                },
                "starColor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777215
                }
              },
              "required": [
                "primary",
                "secondary",
                "background",
                "cardBg",
                "textColor"
              ],
              "additionalProperties": false
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "shuffleQuestions": {
              "type": "boolean"
            },
            "shuffleChoices": {
              "type": "boolean"
            },
            "language": {
              "type": "string",
              "enum": [
                "en",
                "ro"
              ]
            }
          },
          "required": [
            "gameId",
            "version",
            "totalSteps",
            "title",
            "theme",
            "difficulty",
            "shuffleQuestions",
            "shuffleChoices",
            "language"
          ],
          "additionalProperties": false
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "audio": {
                    "type": "string"
                  },
                  "image": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image",
                        "audio"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "isCorrect": {
                      "type": "boolean"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "value",
                    "isCorrect"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 6
              },
              "timeLimit": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "question",
              "choices"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "meta",
        "questions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Fully hydrated game configuration (runtime)"
}