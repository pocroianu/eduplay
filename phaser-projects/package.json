{
  "name": "phaser-projects",
  "version": "0.1.0",
  "description": "Monorepo for educational Phaser games - edu-play organization",
  "private": true,
  "scripts": {
    "build:all": "npm --prefix .. run build --workspace=@edu-play/validation && npm --prefix .. run build --workspace=@edu-play/phaser-ui --workspace=@edu-play/game-core --workspace=@edu-play/ai-content --workspace=config-editor && npm --prefix .. run build:host --workspace=@edu-play/game-core",
    "start:activities": "npm --prefix .. run dev:host --workspace=@edu-play/game-core",
    "start:config-editor": "npm --prefix .. run start --workspace=config-editor",
    "build:config-editor": "npm --prefix .. run build --workspace=config-editor",
    "generate:schemas": "npm --prefix .. run generate-schemas --workspace=@edu-play/validation",
    "ai:setup": "npm --prefix .. run generate --workspace=@edu-play/ai-content -- setup-services",
    "ai:health": "npm --prefix .. run generate --workspace=@edu-play/ai-content -- check-health",
    "ai:models": "npm --prefix .. run generate --workspace=@edu-play/ai-content -- download-models --all",
    "validate:all-configs": "npm --prefix .. run build --workspace=@edu-play/validation --silent && ts-node scripts/validate-all-configs.ts",
    "validate:config": "npm --prefix .. run validate-config --workspace=@edu-play/validation --",
    "migrate:activity-assets": "node scripts/migrate-activity-assets-to-library.mjs",
    "import:activity-package": "node scripts/import-activity-package.mjs",
    "lint": "npm --prefix .. run lint --workspace=@edu-play/ai-content",
    "test": "npm run test:e2e",
    "test:validation": "npm --prefix .. test --workspace=@edu-play/validation",
    "test:config-validation": "node --test scripts/__tests__/*.test.mjs",
    "test:game-core": "npm --prefix .. test --workspace=@edu-play/game-core",
    "test:phaser-ui": "npm --prefix .. test --workspace=@edu-play/phaser-ui",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:activity-dist": "playwright test --config=e2e/playwright.activity-dist.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:chromium": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:activity-interaction": "playwright test --config=e2e/playwright.config.ts --project=activity-host e2e/tests/activity-host/activity-interaction.spec.ts",
    "test:e2e:report": "playwright show-report e2e/playwright-report"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edu-play/phaser-projects.git"
  },
  "keywords": [
    "phaser",
    "educational",
    "games",
    "kids",
    "learning",
    "monorepo"
  ],
  "author": "edu-play",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=11.6.2"
  }
}
