{
  "name": "@edu-play/ai-content",
  "version": "1.0.0",
  "description": "Open-source AI-powered content generation for educational Phaser games",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "require": "./dist/common/index.js",
      "default": "./dist/common/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "edu-generate": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "ts-node src/providers/__tests__/run-integration.ts",
    "lint": "eslint src/",
    "generate": "ts-node src/cli/index.ts",
    "train:lora:spike": "ts-node --transpile-only scripts/train-lora-spike.ts",
    "benchmark:image:spike": "ts-node --transpile-only scripts/benchmark-image-models.ts"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "12.1.0",
    "compromise": "14.14.5",
    "dotenv": "16.6.1",
    "inquirer": "9.3.8",
    "natural": "6.12.0",
    "ora": "8.2.0",
    "p-queue": "8.1.1",
    "redis": "4.7.1",
    "sharp": "0.33.5",
    "syllable": "5.0.1",
    "uuid": "11.1.0",
    "ws": "8.19.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/inquirer": "9.0.9",
    "@types/node": "24.10.13",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "keywords": [
    "ai",
    "content-generation",
    "phaser",
    "educational",
    "stable-diffusion",
    "comfyui",
    "tts"
  ],
  "license": "MIT"
}
